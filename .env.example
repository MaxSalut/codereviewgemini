# Скопіюйте цей файл як .env і впишіть свої значення. Файл .env НЕ потрапляє на GitHub.

# Ключ Google Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=вставте_сюди_ключ

# Модель за замовчуванням (безкоштовні: gemini-3.8-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash
# Рівень «роздумів» моделі: low (швидше) / medium / high
GEMINI_THINKING_LEVEL=low

# Supabase → Project Settings → API Keys (і Data API для URL)
# Якщо залишити порожніми, сервер писатиме історію у файл data/history.db
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Необов'язково
# GEMINI_TIMEOUT_SECONDS=55
# GEMINI_MAX_RETRIES=2
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# ENABLE_PRO_MODEL=false
# PORT=5000
